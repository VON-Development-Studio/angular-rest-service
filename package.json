{
  "name": "@von-development-studio/angular-rest-service",
  "version": "0.0.0",
  "description": "Angular Rest Service wrapper.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VON-Development-Studio/angular-rest-service.git"
  },
  "keywords": [
    "angular",
    "rest client"
  ],
  "author": "Luis García Castro",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve example",
    "build": "ng build",
    "build:lib": "ng build --configuration production ng-rest-service",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ng-rest-service",
    "test:demo": "ng test example",
    "test:ci": "ng test ng-rest-service --no-watch --no-progress",
    "publish:rel": "cd dist/ng-rest-service && npm publish --tag latest --access public",
    "publish:snapshot": "cd dist/ng-rest-service && npm publish --tag snapshot --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/browser-preview": "^5.0.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "playwright": "^1.63.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
